/* Global theme */
QWidget {
    background-color: #0f172a;
    color: #e2e8f0;
    font-family: "Segoe UI", "Helvetica Neue", Arial;
    font-size: 12pt;
}

QMainWindow::separator {
    background: #1e293b;
    width: 1px;
}

QStatusBar {
    background: #0b1220;
    color: #cbd5e1;
}

QGroupBox {
    border: 1px solid #1e293b;
    border-radius: 6px;
    margin-top: 12px;
    padding: 6px 8px 8px 8px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    padding: 0 4px;
}

QLabel {
    color: #cbd5e1;
    font-weight: 500;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background: #0b1220;
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #2563eb;
    selection-color: #e2e8f0;
}

QListWidget, QTreeWidget {
    background: #0b1220;
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 4px;
}

QScrollBar:vertical {
    background: #0b1220;
    width: 10px;
    margin: 4px 2px 4px 0px;
}
QScrollBar::handle:vertical {
    background: #334155;
    min-height: 24px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #475569;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QPushButton {
    background-color: #1d4ed8;
    color: #e2e8f0;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #2563eb;
}
QPushButton:pressed {
    background-color: #1e40af;
}
QPushButton:disabled {
    background-color: #1e293b;
    color: #64748b;
}

QToolTip {
    color: #e2e8f0;
    background-color: #1e293b;
    border: 1px solid #334155;
}

QTabWidget::pane {
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 6px;
}
QTabBar::tab {
    background: #0b1220;
    color: #cbd5e1;
    padding: 6px 12px;
    border: 1px solid #1e293b;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
QTabBar::tab:selected {
    background: #1e293b;
    color: #e2e8f0;
}
QTabBar::tab:hover {
    background: #162033;
}
